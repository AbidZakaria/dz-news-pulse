# Copy to .env to override the defaults used by docker-compose.yml.
# Defaults are fine for a local demo - never reuse them anywhere public.
WAREHOUSE_DB=news
WAREHOUSE_USER=news
WAREHOUSE_PASSWORD=news
AIRFLOW_SECRET_KEY=dev-only-change-me

# Optional: Slack- or Discord-compatible incoming webhook. When set, any failed
# Airflow task posts a message there; when empty, failures are only logged.
ALERT_WEBHOOK_URL=
